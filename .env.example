# ==============================================================================
# Multi-Agent Scientific Claim Verification System (MASCV)
# Environment Configuration Template
# ==============================================================================

# --- Google Gemini / Gemma API Credentials ---
# Obtain an API key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# --- Standardized Google Gemma 4 Model Selection ---
DEFAULT_MODEL=gemma-4-26b-a4b-it
SUPERVISOR_MODEL=gemma-4-26b-a4b-it
CLAIM_ANALYST_MODEL=gemma-4-26b-a4b-it
PAPER_SEARCH_MODEL=gemma-4-26b-a4b-it
EVIDENCE_RAG_MODEL=gemma-4-26b-a4b-it
SUPPORT_AGENT_MODEL=gemma-4-26b-a4b-it
ATTACK_AGENT_MODEL=gemma-4-26b-a4b-it
CRITIC_AGENT_MODEL=gemma-4-26b-a4b-it

# --- Thinking / Reasoning Level ---
# Minimal for fast execution, high for deep reasoning
THINKING_LEVEL=minimal

# --- Academic Search Configuration ---
ARXIV_USER_AGENT=MASCV-ResearchAgent/1.0 (mailto:researcher@example.com)

# --- Execution & Loop Hyperparameters ---
MAX_INVESTIGATION_ITERATIONS=3
EVIDENCE_CONFIDENCE_THRESHOLD=0.70
MIN_INDEPENDENT_SOURCES=2
LOG_LEVEL=INFO
