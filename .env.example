# ==============================================================================
# Multi-Agent Scientific Claim Verification System (MASCV)
# Environment Configuration Template
# ==============================================================================

# --- LLM Providers & API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Default Model Selection ---
SUPERVISOR_MODEL=gpt-4o
CLAIM_ANALYST_MODEL=gpt-4o-mini
PAPER_SEARCH_MODEL=gpt-4o-mini
EVIDENCE_RAG_MODEL=gpt-4o-mini
SUPPORT_AGENT_MODEL=gpt-4o
ATTACK_AGENT_MODEL=gpt-4o
CRITIC_AGENT_MODEL=gpt-4o

# --- Academic & Web Search APIs ---
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here
ARXIV_USER_AGENT=MASCV-ResearchAgent/1.0 (mailto:researcher@example.com)

# --- Embedding & Vector Store ---
EMBEDDING_PROVIDER=huggingface # huggingface, openai
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
VECTOR_DB_TYPE=chroma # chroma, faiss
VECTOR_DB_PATH=./data/vector_db

# --- Execution & Limits ---
MAX_INVESTIGATION_ITERATIONS=3
EVIDENCE_CONFIDENCE_THRESHOLD=0.75
MAX_EXTERNAL_PAPERS_PER_CLAIM=5
LOG_LEVEL=INFO
